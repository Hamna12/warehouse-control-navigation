#!/usr/bin/env python3
"""MCP server exposing Isaac Sim tools to Claude."""
import pathlib
import socket
import sys

# Ensure sibling scripts are importable when run as __main__
sys.path.insert(0, str(pathlib.Path(__file__).parent))

from mcp.server.fastmcp import FastMCP
from isaac_send import send_code
from isaac_console import latest_log, read_log_entries, LOG_BASE_DIR

mcp = FastMCP("isaac-sim")

# Byte offset into the latest log file recorded before the last code execution.
# Used by get_isaac_console to return only new entries.
_last_run_log_offset: int = 0

# Log directory queried from Isaac Sim via carb.settings after first execution.
# None until populated; falls back to glob-based detection when unset.
_cached_log_dir: pathlib.Path | None = None


def _try_cache_log_dir(host: str, port: int) -> None:
    """Query Isaac Sim for its log directory and cache it for this session."""
    global _cached_log_dir
    if _cached_log_dir is not None:
        return
    try:
        result = send_code(
            host, port,
            "import carb.settings\nprint(carb.settings.get_settings().get('/log/file'))",
            5.0,
        )
        p = pathlib.Path(result.strip()).parent
        if p.is_dir():
            _cached_log_dir = p
    except (OSError, RuntimeError):
        pass


def _log_file_offset(log_file: pathlib.Path) -> int:
    """Return the current end-of-file byte offset for log_file."""
    try:
        return log_file.stat().st_size
    except OSError:
        return 0


@mcp.tool()
def check_isaac_connection(
    host: str = "127.0.0.1",
    port: int = 8226,
) -> str:
    """Check whether Isaac Sim's VS Code executor is reachable on host:port."""
    try:
        with socket.create_connection((host, port), timeout=0.5):
            pass
        return f"Isaac Sim is reachable at {host}:{port}"
    except ConnectionRefusedError:
        return f"Isaac Sim is NOT reachable at {host}:{port} — connection refused"
    except OSError as exc:
        return f"Isaac Sim is NOT reachable at {host}:{port} — {exc}"


@mcp.tool()
def execute_isaac_code(
    code: str,
    host: str = "127.0.0.1",
    port: int = 8226,
    timeout: float = 10.0,
) -> str:
    """Execute Python code inside Isaac Sim and return the output.

    Checks connectivity first; snapshots the log file offset before running so
    that get_isaac_console(since_last_run=True) returns only new log entries.

    timeout: seconds to wait for Isaac Sim to finish and respond.
    Increase for long-running operations such as loading a USD stage,
    running a simulation loop, or training steps (e.g. 60–120s).
    """
    global _last_run_log_offset

    # Connectivity check
    status = check_isaac_connection(host=host, port=port)
    if "NOT reachable" in status:
        return status

    # Resolve log directory before snapshotting offset so the first run
    # uses the exact path from Isaac Sim rather than the glob fallback.
    _try_cache_log_dir(host, port)

    # Snapshot log offset before execution
    try:
        log_file = latest_log(_cached_log_dir or LOG_BASE_DIR)
        _last_run_log_offset = _log_file_offset(log_file)
    except FileNotFoundError:
        # No log files yet — offset stays at 0
        _last_run_log_offset = 0

    # Send code and return result
    try:
        return send_code(host, port, code, timeout)
    except OSError as exc:
        return f"Connection error: {exc}"
    except RuntimeError as exc:
        return str(exc)


@mcp.tool()
def get_isaac_console_errors_warnings(
    errors_only: bool = False,
    count: int = 50,
    since_last_run: bool = True,
    since: str | None = None,
) -> str:
    """Return warning/error lines from the latest Isaac Sim log file.

    Filtering priority (first match wins):
    1. ``since`` — ISO-8601 timestamp string (e.g. "2026-02-26T16:43:09Z").
       Scans the full log and returns only entries at or after that time.
       Overrides since_last_run when provided.
    2. ``since_last_run=True`` (default) — returns only lines written after
       the most recent execute_isaac_code call (byte-offset based).
    3. ``since_last_run=False`` — returns all historical entries.
    """
    try:
        log_file = latest_log(_cached_log_dir or LOG_BASE_DIR)
    except FileNotFoundError as exc:
        return str(exc)

    if since is not None:
        lines, _ = read_log_entries(
            log_file, errors_only=errors_only, count=count, since=since
        )
        scope = f"since {since}"
    else:
        from_offset = _last_run_log_offset if since_last_run else 0
        lines, _ = read_log_entries(
            log_file, errors_only=errors_only, count=count, from_offset=from_offset
        )
        scope = "since last run" if since_last_run else "total"

    label = "error" if errors_only else "warning/error"
    header = f"[{log_file.name}]  {len(lines)} {label} messages ({scope})\n"
    if not lines:
        return header + "(none)"
    return header + "\n".join(lines)


def main() -> None:
    mcp.run()


if __name__ == "__main__":
    main()
